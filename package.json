{
  "name": "overbuddy",
  "version": "2.2.0",
  "private": true,
  "author": "Kirill Tregubov",
  "repository": "https://github.com/KirillTregubov/OverBuddy",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "validate": "pnpm validate:frontend && pnpm validate:rust",
    "validate:frontend": "pnpm vite-build && pnpm lint && pnpm format:check",
    "validate:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "vite-dev": "vite",
    "vite-build": "tsc && vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "update": "tsx scripts/update.ts",
    "sync": "tsx scripts/sync.ts",
    "cleanup": "tsx scripts/cleanup.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-shell": "~2.3.5",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "globals": "^17.6.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^1.7.4",
    "tailwind-easing-gradients": "^1.0.2",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.8.18",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@tauri-apps/cli": "^2.11.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "oxfmt": "^0.54.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "readline-sync": "^1.4.10",
    "semver": "^7.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.6.0"
}
